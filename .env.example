# Copy to .env.local for local development (never commit real secrets).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Public URL of the deployed site (canonical, Open Graph, sitemap.xml, robots.txt).
SITE_URL=https://rohit-kamble-portfolio-v2.vercel.app

# Contact form (api/contact.js) via https://resend.com
RESEND_API_KEY=
# Inbox that receives messages (defaults to the email shown on the site)
CONTACT_TO_EMAIL=itsrohitrk.official@gmail.com
# Verified sender. Leave empty to use Resend's test sender, which can only deliver
# to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=
